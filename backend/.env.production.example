# Backend Production Environment Configuration - EXAMPLE
# Copy to .env.production and fill in real values. Never commit real secrets.

# ========== SERVER ==========
PORT=5000
NODE_ENV=production

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@your-cluster.mongodb.net/waterpulse

# ========== SECURITY ==========
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ========== CORS ==========
# Include both with and without www:
CORS_ORIGIN=https://your-frontend-domain.example,https://www.your-frontend-domain.example

# ========== FRONTEND ==========
# Used to build the redirect URL after Google sign-in completes
FRONTEND_URL=https://your-frontend-domain.example

# ========== EMAIL SERVICE (Resend) ==========
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=WaterPulse <noreply@your-domain.example>

# ========== WEATHER & LOCATION SERVICE ==========
OPENWEATHER_API_KEY=your_openweather_api_key
NOMINATIM_USER_AGENT=WaterPulseApp/1.0 (you@example.com)

# ========== SMS SERVICE (SMS8.io) ==========
SMS8_API_KEY=your_sms8_api_key
SMS8_DEVICE_ID=your_sms8_device_id

# ========== GOOGLE SIGN-IN (OAuth2 / OIDC) ==========
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.example/api/auth/google/callback
